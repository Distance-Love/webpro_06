<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>アークナイツ図鑑</title>
</head>
<body>
  <h2>アークナイツの図鑑表</h2>
  <table>
    <tr><th>ID</th><th>職業</th><th>オペレーター名</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.code %></td>
        <td><%= row.job %></td>
        <td><%= row.name %></td></tr>
      <% } %>
  </table>
</body>
</html>